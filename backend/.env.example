# Backend-only secret: obtain from https://account.heigit.org/
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Include your contact URL/email for hosted demos.
PROVIDER_USER_AGENT=Rendezvous/0.1 (local hackathon prototype)
# Add the frontend origin used by each device (for example, the host's LAN IP).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_DB_PATH=./data/rendezvous.sqlite3
# Set both for a cross-site production frontend/API deployment.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
